DATABASE_URL=postgres://vibe_user:vibe_password@localhost:5432/vibe_db
JWT_SECRET=your-secret-key
REFRESH_SECRET=your-refresh-secret-key

# Python 学情预测 gRPC（成绩等级预测唯一路径，失败返回 503，无规则降级）
# 本地 Next 连宿主机映射端口；若 Next 也在 Compose 网络内可改为 python:50051
GRPC_STUDENT_ANALYSIS_URL=127.0.0.1:50051

# AIGC API Key
AIGC_MODE="moonshot-v1-8k"
AIGC_API_KEY="MOONSHOT_API_KEY"
AIGC_BASE_URL="https://api.moonshot.cn/v1"

# RAG: OpenAI-compatible POST .../embeddings. Vector dim must be 1536 (Qdrant collection).
# EMBEDDING_MODEL 必须是「嵌入模型」，不能用对话模型（如 qwen*-plus），否则会 model_not_supported。
EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_BASE_URL="https://api.openai.com/v1"
# EMBEDDING_API_KEY="sk-..."
#
# 阿里云百炼 OpenAI 兼容示例（国内）：
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=你的百炼_API_Key

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="vibe-ai-assistant"